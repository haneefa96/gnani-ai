# --- voice (A) ---
VOICE_IMPL=fake
GNANI_API_KEY=
GNANI_HEADER_STYLE=new
GNANI_STT_MODEL=prisma-v3.0
GNANI_TTS_MODEL=timbre-v3.0
GNANI_STT_WSS_URL=wss://api.vachana.ai/stt/v3/stream
GNANI_STT_REST_URL=https://api.vachana.ai/stt/v3
GNANI_TTS_WSS_URL=wss://api.vachana.ai/api/v1/tts
GNANI_TTS_REST_URL=https://api.vachana.ai/api/v1/tts/inference
# Default voices ("Shivani", "Avinash") must be verified in the Gnani playground.
VOICE_TTS_VOICE_WORKER=Shivani
VOICE_TTS_VOICE_CONTRACTOR=Avinash
GNANI_TTS_SPEED=0.9
GNANI_TTS_FORMAT=wav
GNANI_VAD_NARRATION_MIN_SILENCE_MS=700
GNANI_VAD_NARRATION_THRESHOLD=0.6
GNANI_VAD_CONFIRM_MIN_SILENCE_MS=300
GNANI_VAD_CONFIRM_MIN_SPEECH_MS=100
GNANI_VAD_CONFIRM_MIN_SEGMENT_MS=100
VOICE_TTS_CACHE_DIR=data/tts_cache
VOICE_AUDIO_STUB_DIR=data/audio
VOICE_KEYTERMS_ENABLED=false
VOICE_STT_TIMEOUT_S=30.0
VOICE_TTS_TIMEOUT_S=30.0
VOICE_LLM_ENABLED=true
VOICE_LLM_PROVIDER=gemini
VOICE_LLM_TIMEOUT_S=30.0
GEMINI_API_KEY=
GEMINI_MODEL=
# Optional comma-separated fallback models tried if primary returns 404/429/5xx/timeout
GEMINI_FALLBACK_MODELS=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models
# Optional (e.g. MINIMAL for Gemini 3.x models; auto-dropped on HTTP 400 fallback)
GEMINI_THINKING_LEVEL=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=
