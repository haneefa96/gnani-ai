# --- voice (Developer A) ---
# Gnani STT API configuration
GNANI_STT_API_KEY=
GNANI_STT_WSS_URL=wss://api.vachana.ai/stt/v3/stream

# Gnani TTS API configuration
GNANI_TTS_API_KEY=
GNANI_TTS_WSS_URL=wss://api.vachana.ai/api/v1/tts

# Voice implementation selection
VOICE_IMPL=fake  # "fake" for FakeVoice, "gnani" for real integration

# LLM configuration (for extraction)
LLM_PROVIDER=ollama
LLM_MODEL=

# --- app (Developer B) ---
# Database configuration (SQLite local default, or Neon Postgres connection string)
# Neon example: DATABASE_URL=postgresql://USER:PASSWORD@EP-HOST.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./saakshi.db

# Security
# Required: use a cryptographically random value of at least 32 characters.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Share token configuration
SHARE_TOKEN_EXPIRY_DAYS=3

# Audio storage
AUDIO_STORAGE_PATH=./data/audio
